# =============================================================================
# s21-rpg-cards - Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust values for your local setup:
#   cp .env.example .env
#
# .env is gitignored (see .gitignore:22). Never commit real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Database - required by Prisma
# Used in: packages/database/prisma.config.ts:12 (process.env.DATABASE_URL)
#          via `import "dotenv/config"` + prisma/config defineConfig
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Default docker-compose.yml values (docker-compose.yml:7-10):
#   POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgres, POSTGRES_DB=s21-rpg-cards
#   Host port 5432 -> container 5432
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/s21-rpg-cards?schema=public"

# ---------------------------------------------------------------------------
# API - NestJS server (apps/api)
# Used in: apps/api/src/main.ts:6 (process.env.PORT ?? 3001)
# ---------------------------------------------------------------------------
PORT=3001

# ---------------------------------------------------------------------------
# Keycloak / Auth - 21-School authentication
# Currently defined in root .env (KEYCLOAK_URL, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID)
# Expected to be consumed by future auth module (not yet wired in apps/api).
# ---------------------------------------------------------------------------
KEYCLOAK_URL=https://auth.21-school.ru/auth
KEYCLOAK_REALM=EduPowerKeycloak
KEYCLOAK_CLIENT_ID=s21-open-api

# Token encryption key for AES-256-GCM (32 bytes hex = 64 hex chars)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# CP2 Sync Service - School21 data synchronization
# Used in: apps/api (school21 client + sync scheduler, to be wired in later waves)
# SCHOOL21_API_BASE_URL: School21 Open API base URL, consumed by the school21 client in apps/api
# SYNC_CRON: 6-field cron with seconds (@nestjs/schedule)
#           default every 10 minutes - must fire at least once within Keycloaks offline session idle window
# SYNC_TTL_MINUTES: cached card data TTL in minutes
# ---------------------------------------------------------------------------
SCHOOL21_API_BASE_URL=https://platform.21-school.ru/services/21-school/api/v1
SYNC_CRON=0 */10 * * * *
SYNC_TTL_MINUTES=15
